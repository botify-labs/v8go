diff --git a/isolate.go b/isolate.go
index 4f152ce..4c373c7 100644
--- a/isolate.go
+++ b/isolate.go
@@ -153,6 +153,25 @@ func NewIsolate(opts ...IsolateOption) *Isolate {
 
 // TerminateExecution terminates forcefully the current thread
 // of JavaScript execution in the given isolate.
+//
+// Botify: it can be called from any goroutine, and terminates the whole run
+// in progress, i.e. the top-level script or function call, with the Go
+// callbacks it calls and the scripts they run: their later V8 calls don't
+// cancel it, and the JavaScript those run is terminated at its first
+// instruction. Requested while no run is in progress, it terminates the next
+// run of RunScript, UnboundScript.Run, Function.Call, Function.NewInstance or
+// PerformMicrotaskCheckpoint, on whatever OS thread it runs (V8 itself keeps
+// the request with the state of one thread, so that a run on another thread
+// missed it and a later run of the first thread got it instead). Requested
+// just as a run ends, it is dropped rather than terminate the next run;
+// Isolate.Cleanup cancels the requests made until it ends.
+//
+// Other entry points that run JavaScript (Value.String on an object,
+// Object.Get on a getter, JSONStringify...) called at the top level, outside
+// a run, only see a request V8 holds for the calling thread. A watchdog that
+// must stop a run whatever it does should therefore request the termination
+// again periodically until the run returns, rather than once. It must not be
+// called concurrently with Dispose, nor after it.
 func (i *Isolate) TerminateExecution() {
 	C.IsolateTerminateExecution(i.ptr)
 }
